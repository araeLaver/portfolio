<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.portfolio.macmini</string>
    <key>WorkingDirectory</key>
    <string>{{APP_DIR}}</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>{{APP_DIR}}/scripts/run-portfolio.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{APP_DIR}}/logs/portfolio.log</string>
    <key>StandardErrorPath</key>
    <string>{{APP_DIR}}/logs/portfolio.err</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>PORTFOLIO_APP_DIR</key>
      <string>{{APP_DIR}}</string>
      <key>JAVA_HOME</key>
      <string>/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home</string>
    </dict>
  </dict>
</plist>
